<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mcphub.autosend.browser</string>
  <key>ProcessType</key><string>Background</string>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>RunAtLoad</key><true/>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__MCPGO_ROOT__/launchers/browser.mjs</string>
    <string>--autosend</string>
  </array>
  <key>WorkingDirectory</key><string>__MCPGO_ROOT__/playwright</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/McpGo/com.mcphub.autosend.browser.err.log</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/McpGo/com.mcphub.autosend.browser.out.log</string>
  <key>Umask</key><integer>63</integer>
  <key>ThrottleInterval</key><integer>10</integer>
</dict>
</plist>
